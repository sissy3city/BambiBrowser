{
  "manifest_version": 3,
  "name": "BambiBrowser",
  "version": "4.0",
  "description": "Automatic fullscreen video hijack for hypnotube.com — multi‑domain ready.",

  "permissions": [
    "storage",
    "tabs",
    "idle",
    "alarms",
    "webNavigation"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },

  "options_page": "options.html",

  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
