{
  "manifest_version": 2,
  "name": "BambiBrowser",
  "version": "6.5.3",
  "description": "Send videos to BambiBrowser desktop app",

  "permissions": [
    "storage",
    "<all_urls>",
    "https://hypnotube.com/*",
    "https://*.hypnotube.com/*",
    "https://bambicloud.com/*",
    "https://*.bambicloud.com/*",
    "http://127.0.0.1:5655/*",
    "http://127.0.0.1/*",
    "http://localhost/*",
    "http://localhost:5655/*"
  ],

  "background": {
    "scripts": ["site_config.js", "background.js"]
  },

  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "site_config.js",
        "detectors/hypnotube.js",
        "detectors/bambicloud.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],

  "browser_action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "bambibrowser@example.com",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}